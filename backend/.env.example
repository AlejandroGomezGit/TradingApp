# ── Alpaca (paper trading) — https://app.alpaca.markets → API Keys ──
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Anthropic / Claude — https://console.anthropic.com ──
ANTHROPIC_API_KEY=

# ── CoinGecko (opcional, mejora rate limits) ──
COINGECKO_API_KEY=

# ── PostgreSQL local ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=trading

# ── Email (Gmail SMTP) ──
# GMAIL_APP_PASSWORD: Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# ── Parámetros de trading ──
MAX_POSITION_PCT=8
CASH_RESERVE_PCT=20
STOP_LOSS_PCT=8
MAX_LIMIT_SLIPPAGE=0.2

# ── Backtest ──
BACKTEST_CAPITAL=100000
BACKTEST_LOOKBACK=365
DEFAULT_SYMBOLS=SPY,QQQ,NVDA,AAPL,MSFT

# ── Servidor ──
PORT=3000
FRONTEND_URL=http://localhost:4200
LOG_LEVEL=info
